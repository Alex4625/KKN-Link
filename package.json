{
  "name": "kkn-link",
  "version": "1.0.0",
  "description": "",
  "main": "server/app.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "pages:dev": "wrangler pages dev --compatibility-date=2024-09-23 --compatibility-flags=nodejs_compat --d1=DB=kkn-hub-db --local",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kkn-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kkn-hub-db --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
